# 线上部署环境变量 (backend 容器)。复制为 deploy/.env.deploy 后修改。
# 路径均为「容器内」路径: /models 和 /voices 由 docker-compose 卷挂载。

# 真实模型
ASR_ENGINE=funasr
TTS_ENGINE=cosyvoice
DEVICE=cuda

# 节点标识 (Phase 3 灰度对比): 每台机器填不同值, 随请求回显给前端 + 看板按 node 区分。
# 入口机 NODE_NAME=node1 (应用 B 线推理优化); 扩展机 NODE_NAME=node2 (保持旧版基线)。
NODE_NAME=node1

# 音频契约
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# FunASR — 指向挂载进容器的权重目录
FUNASR_MODEL=/models/iic__SenseVoiceSmall
FUNASR_VAD_MODEL=/models/iic__speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_USE_ITN=true

# CosyVoice2 — 仓库已在镜像内 /opt/CosyVoice; 权重与参考音色经卷挂载
COSYVOICE_REPO_DIR=/opt/CosyVoice
COSYVOICE_MODEL=/models/iic__CosyVoice2-0.5B
COSYVOICE_LOAD_VLLM=false
COSYVOICE_FP16=true
COSYVOICE_DEFAULT_VOICE=default
COSYVOICE_VOICES='{"default": {"audio_path": "/voices/default.wav", "prompt_text": "这里填该段参考音频准确的文字内容"}}'

# CORS: 同源反代无需放开; 如直连后端再按需配置
CORS_ORIGINS=["*"]

# ---- Phase 2: 第二个 ASR (Paraformer-zh 中文高精度 + 时间戳 + 标点) ----
# 留空则不注册第二个引擎; 配了 model id 才会出现在 /api/v1/models 与前端下拉。
FUNASR_PARAFORMER_MODEL=/models/iic__speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_PUNC_MODEL=/models/iic__punc_ct-transformer_zh-cn-common-vocab272727-pytorch
# 默认对外 ASR 模型 name (留空=第一个注册的, 即 funasr-sensevoice)
DEFAULT_ASR_MODEL=funasr-sensevoice

# ---- Phase 2: 并发控制 / 降级熔断 / 优雅退出 (单 T4) ----
ASR_CONCURRENCY=2
TTS_CONCURRENCY=2
GPU_ACQUIRE_TIMEOUT=10.0
GPU_RETRY_AFTER=2
# 主引擎失败时自动降级到其余已注册引擎
ASR_FALLBACK_ENABLED=true
# 连续失败 N 次熔断该引擎, cooldown 秒内短路跳过
BREAKER_FAIL_THRESHOLD=3
BREAKER_COOLDOWN=30.0
# SIGTERM 后等待存量请求清空的最长时间 (秒)
DRAIN_TIMEOUT=25.0
