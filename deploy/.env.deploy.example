# 线上部署环境变量 (backend 容器)。复制为 deploy/.env.deploy 后修改。
# 路径均为「容器内」路径: /models 和 /voices 由 docker-compose 卷挂载。

# 真实模型
ASR_ENGINE=funasr
TTS_ENGINE=cosyvoice
DEVICE=cuda

# 节点标识: 每台机器填不同值, 随请求回显给前端 + 看板按 node 区分。
NODE_NAME=primary

# 音频契约
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# FunASR — 指向挂载进容器的权重目录
FUNASR_MODEL=/models/iic__SenseVoiceSmall
FUNASR_VAD_MODEL=/models/iic__speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_USE_ITN=true

# CosyVoice2 — 仓库已在镜像内 /opt/CosyVoice; 权重与参考音色经卷挂载
COSYVOICE_REPO_DIR=/opt/CosyVoice
COSYVOICE_MODEL=/models/iic__CosyVoice2-0.5B
COSYVOICE_LOAD_VLLM=false
COSYVOICE_FP16=false
COSYVOICE_DEFAULT_VOICE=中文女
COSYVOICE_VOICES='{"中文女": {"audio_path": "/voices/default.wav", "prompt_text": "这里填女声参考音频准确的文字内容"}, "中文男": {"audio_path": "/voices/male.wav", "prompt_text": "这里填男声参考音频准确的文字内容"}}'
TTS_SENTENCE_STREAM=false
TTS_MAX_SENTENCE_CHARS=60
TTS_MIN_SENTENCE_CHARS=0
TTS_STREAM_QUEUE_CHUNKS=8

# CORS: 同源反代无需放开; 如直连后端再按需配置
CORS_ORIGINS=["*"]

# ---- Phase 2: 第二个 ASR (Paraformer-zh 中文高精度 + 时间戳 + 标点) ----
# 已下线: SeacoParaformer 是 Paraformer 的功能超集 (不给热词时退化为同一基座,
# 实测同音频逐字一致), 保留两者属冗余。故注释掉, 由 funasr-seaco 顶替其位置。
# 如需恢复 A/B 对比, 取消下一行注释即可。
# FUNASR_PARAFORMER_MODEL=/models/iic__speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
# 标点模型: funasr-seaco 仍用它恢复标点 (seaco/paraformer 自身不含标点), 必须保留。
FUNASR_PUNC_MODEL=/models/iic__punc_ct-transformer_zh-cn-common-vocab272727-pytorch
# SeacoParaformer 热词模型 (唯一真正支持热词偏置的 ASR, name=funasr-seaco)。
# 留空则不注册; 仅文件式路径 (上传音频) 的热词生效, 实时流式无热词。
FUNASR_SEACO_MODEL=/models/iic__speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
# 默认对外 ASR 模型 name (留空=第一个注册的, 即 funasr-sensevoice)
DEFAULT_ASR_MODEL=funasr-sensevoice

# ---- Phase 2: 并发控制 / 降级熔断 / 优雅退出 (单 T4) ----
ASR_CONCURRENCY=2
TTS_CONCURRENCY=2
GPU_ACQUIRE_TIMEOUT=10.0
GPU_RETRY_AFTER=2
# 主引擎失败时自动降级到其余已注册引擎
ASR_FALLBACK_ENABLED=true
# 连续失败 N 次熔断该引擎, cooldown 秒内短路跳过
BREAKER_FAIL_THRESHOLD=3
BREAKER_COOLDOWN=30.0
# SIGTERM 后等待存量请求清空的最长时间 (秒)
DRAIN_TIMEOUT=25.0

# ---- Phase 3: 语音聊天 (speech-to-speech, 对接远端 OpenAI 兼容 Agent) ----
# 如不需要语音聊天可设为 false；启用时请配置自己的 OpenAI-compatible Agent。
CHAT_ENABLED=true
# OpenAI 官方 base; 换其它兼容服务 (DashScope/方舟/vLLM) 改这里即可。
AGENT_ENDPOINT=https://api.openai.com/v1
# 真实 key 只写本文件 (deploy/.env.deploy), 已在 sync 排除清单, 不入库。
AGENT_API_KEY=
AGENT_MODEL=gpt-4o
AGENT_MAX_TURNS=8
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=1024
AGENT_TIMEOUT=60.0
AGENT_FIRST_TOKEN_TIMEOUT=15.0
AGENT_CONCURRENCY=4
AGENT_TTS_VOICE=中文女
AGENT_TTS_SPEED=1.0
# 线上用真流式 ASR 出字更快
AGENT_ASR_MODEL=funasr-streaming
CHAT_BARGE_IN=false
CHAT_BARGE_IN_MIN_CHARS=2
CHAT_MIN_SPEECH_CHARS=2
CHAT_MIN_SPEECH_MS=300

# ---- 原生端到端语音 (Qwen-Omni-Realtime，可选) ----
# 使用百炼 Workspace 专属地址；真实 API Key 只写 deploy/.env.deploy，不入库。
QWEN_OMNI_ENABLED=false
# 北京地域示例: wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_OMNI_ENDPOINT=
QWEN_OMNI_API_KEY=
QWEN_OMNI_MODEL=qwen3.5-omni-flash-realtime
QWEN_OMNI_MODEL_ALLOWLIST=["qwen3.5-omni-flash-realtime","qwen3.5-omni-plus-realtime"]
QWEN_OMNI_VOICES=["Tina"]
QWEN_OMNI_DEFAULT_VOICE=Tina
QWEN_OMNI_CONCURRENCY=4
QWEN_OMNI_TURN_DETECTION=semantic_vad
QWEN_OMNI_VAD_THRESHOLD=0.5
QWEN_OMNI_SILENCE_MS=2000
QWEN_OMNI_SILENCE_OPTIONS=[800,1500,2000]
