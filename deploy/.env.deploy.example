# 线上部署环境变量 (backend 容器)。复制为 deploy/.env.deploy 后修改。
# 路径均为「容器内」路径: /models 和 /voices 由 docker-compose 卷挂载。

# 真实模型
ASR_ENGINE=funasr
TTS_ENGINE=cosyvoice
DEVICE=cuda

# 音频契约
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# FunASR — 指向挂载进容器的权重目录
FUNASR_MODEL=/models/iic__SenseVoiceSmall
FUNASR_VAD_MODEL=/models/iic__speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_USE_ITN=true

# CosyVoice2 — 仓库已在镜像内 /opt/CosyVoice; 权重与参考音色经卷挂载
COSYVOICE_REPO_DIR=/opt/CosyVoice
COSYVOICE_MODEL=/models/iic__CosyVoice2-0.5B
COSYVOICE_LOAD_VLLM=false
COSYVOICE_FP16=true
COSYVOICE_DEFAULT_VOICE=default
COSYVOICE_VOICES='{"default": {"audio_path": "/voices/default.wav", "prompt_text": "这里填该段参考音频准确的文字内容"}}'

# CORS: 同源反代无需放开; 如直连后端再按需配置
CORS_ORIGINS=["*"]
