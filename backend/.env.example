# ===== 引擎选择 =====
# stub(本地无GPU默认) | funasr | cosyvoice
ASR_ENGINE=stub
TTS_ENGINE=stub

# 计算设备: cpu | mps(Apple Silicon) | cuda
DEVICE=cpu

# ===== 音频契约 =====
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# ===== FunASR (ASR) =====
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_USE_ITN=true

# ===== CosyVoice2 (TTS) =====
# CosyVoice 仓库根目录 (含 third_party/Matcha-TTS)
COSYVOICE_REPO_DIR=
# 模型权重目录 (本地路径) 或 ModelScope id
COSYVOICE_MODEL=iic/CosyVoice2-0.5B
COSYVOICE_LOAD_VLLM=false
COSYVOICE_FP16=false
COSYVOICE_DEFAULT_VOICE=中文女
# 零样本参考音色 (JSON): 音色名 -> {参考音频路径(16k wav), 该音频对应文本}
# COSYVOICE_VOICES='{"中文女": {"audio_path": "./voices/default.wav", "prompt_text": "希望你以后能做得比我还好"}, "中文男": {"audio_path": "./voices/male.wav", "prompt_text": "这里填男声参考音频准确的文字内容"}}'
# 多句文本按句流式合成；单段最大/最小字符数用于平衡首包和句间平滑。
TTS_SENTENCE_STREAM=false
TTS_MAX_SENTENCE_CHARS=60
TTS_MIN_SENTENCE_CHARS=0
# CosyVoice 同步生成线程到 WebSocket 的有界队列水位。
TTS_STREAM_QUEUE_CHUNKS=8

# ===== 语音聊天 (speech-to-speech, 对接远端 OpenAI 兼容 Agent) =====
# 总开关; 关闭或不配 AGENT_ENDPOINT 时 /ws/chat 返回 unavailable, 不影响 ASR/TTS。
CHAT_ENABLED=false
# 远端 Agent base (OpenAI 兼容), 带或不带 /v1 均可。OpenAI 官方: https://api.openai.com/v1
AGENT_ENDPOINT=
# 鉴权 key: 请勿提交真实 key 入库; 线上写 deploy/.env.deploy。
AGENT_API_KEY=
AGENT_MODEL=gpt-4o
# AGENT_SYSTEM_PROMPT=你是一个友好的语音助手，用简短、口语化的中文回答。
AGENT_MAX_TURNS=8
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=1024
AGENT_TIMEOUT=60.0
AGENT_FIRST_TOKEN_TIMEOUT=15.0
AGENT_CONCURRENCY=4
AGENT_TTS_VOICE=中文女
AGENT_TTS_SPEED=1.0
# 留空=用默认 ASR; 线上建议 funasr-streaming (真流式)
AGENT_ASR_MODEL=
CHAT_BARGE_IN=false
CHAT_BARGE_IN_MIN_CHARS=2
CHAT_MIN_SPEECH_CHARS=2
CHAT_MIN_SPEECH_MS=300

# ===== 原生端到端语音 (Qwen-Omni-Realtime，可选) =====
# 需同时保持 CHAT_ENABLED=true。API Key 和 Workspace 地址只写本地 .env，不入库。
QWEN_OMNI_ENABLED=false
# 北京地域示例: wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_OMNI_ENDPOINT=
QWEN_OMNI_API_KEY=
QWEN_OMNI_MODEL=qwen3.5-omni-flash-realtime
QWEN_OMNI_MODEL_ALLOWLIST=["qwen3.5-omni-flash-realtime","qwen3.5-omni-plus-realtime"]
QWEN_OMNI_VOICES=["Tina"]
QWEN_OMNI_DEFAULT_VOICE=Tina
QWEN_OMNI_CONCURRENCY=4
QWEN_OMNI_TURN_DETECTION=semantic_vad
QWEN_OMNI_VAD_THRESHOLD=0.5
QWEN_OMNI_SILENCE_MS=2000
QWEN_OMNI_SILENCE_OPTIONS=[800,1500,2000]
