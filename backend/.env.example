# ===== 引擎选择 =====
# stub(本地无GPU默认) | funasr | cosyvoice
ASR_ENGINE=stub
TTS_ENGINE=stub

# 计算设备: cpu | mps(Apple Silicon) | cuda
DEVICE=cpu

# ===== 音频契约 =====
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1

# ===== FunASR (ASR) =====
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_USE_ITN=true

# ===== CosyVoice2 (TTS) =====
# CosyVoice 仓库根目录 (含 third_party/Matcha-TTS)
COSYVOICE_REPO_DIR=
# 模型权重目录 (本地路径) 或 ModelScope id
COSYVOICE_MODEL=iic/CosyVoice2-0.5B
COSYVOICE_LOAD_VLLM=false
COSYVOICE_FP16=false
COSYVOICE_DEFAULT_VOICE=default
# 零样本参考音色 (JSON): 音色名 -> {参考音频路径(16k wav), 该音频对应文本}
# COSYVOICE_VOICES='{"default": {"audio_path": "./voices/default.wav", "prompt_text": "希望你以后能做得比我还好"}}'

# ===== 语音聊天 (speech-to-speech, 对接远端 OpenAI 兼容 Agent) =====
# 总开关; 关闭或不配 AGENT_ENDPOINT 时 /ws/chat 返回 unavailable, 不影响 ASR/TTS。
CHAT_ENABLED=false
# 远端 Agent base (OpenAI 兼容), 带或不带 /v1 均可。OpenAI 官方: https://api.openai.com/v1
AGENT_ENDPOINT=
# 鉴权 key: 请勿提交真实 key 入库; 线上写 deploy/.env.deploy。
AGENT_API_KEY=
AGENT_MODEL=gpt-4o
# AGENT_SYSTEM_PROMPT=你是一个友好的语音助手，用简短、口语化的中文回答。
AGENT_MAX_TURNS=8
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=1024
AGENT_TIMEOUT=60.0
AGENT_FIRST_TOKEN_TIMEOUT=15.0
AGENT_CONCURRENCY=4
AGENT_TTS_VOICE=default
AGENT_TTS_SPEED=1.0
# 留空=用默认 ASR; 线上建议 funasr-streaming (真流式)
AGENT_ASR_MODEL=
